{
  "name": "ai-svg-animator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dompurify": "3.4.14",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  }
}
